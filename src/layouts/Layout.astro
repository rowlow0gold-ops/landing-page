  /* Light sky overlay — fades in smoothly */
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    background: linear-gradient(180deg, #e0f0ff 0%, #c8e6ff 40%, #a8d4ff 100%);
    opacity: 0;
    transition: opacity 1s ease;
    z-index: -1;
    pointer-events: none;
