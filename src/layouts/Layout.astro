  body {
    min-height: 100vh;
    background: linear-gradient(180deg, #0a0a1a 0%, #0d1117 40%, #111827 100%);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 2rem 1rem;
    position: relative;
    overflow-x: hidden;
    overflow-y: visible;
